{
  "productName": "LiteDB",
  "version": "2.1.0",
  "identifier": "com.adhamehab.litedb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LiteDB",
        "width": 1200,
        "height": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://*; connect-src 'self' http://localhost:* https://api.openai.com https://models.github.ai https://*.openai.azure.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJENjZFQ0YxRDE3NTgyQUEKUldTcWduWFI4ZXhtdlpNNEhuYk5ybWxWWDFRVTZ1SWJMOU5yVWVNQlFLZk1yempYRTY4N1RtRE4K",
      "endpoints": [
        "https://github.com/createdbyadham/LiteDB/releases/latest/download/latest.json"
      ]
    },
    "fs": {}
  }
}
