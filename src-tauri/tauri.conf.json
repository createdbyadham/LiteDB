{
  "productName": "LiteDB",
  "version": "2.4.0",
  "identifier": "com.adhamehab.litedb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LiteDB",
        "width": 1200,
        "height": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 http://127.0.0.1:1420 ws://127.0.0.1:1420 https://huggingface.co https://*.huggingface.co https://cas-bridge.xethub.hf.co blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4RkY2Qzc3REI1MUVDOEMKUldTTTdGSGJkMnovMkVJQUZ5Z3lVNlZzRE1VNlZoLzZGcExCZGp1NnhybEJrRG5ZMm4veHlpMTYK",
      "endpoints": [
        "https://github.com/createdbyadham/LiteDB/releases/latest/download/latest.json"
      ]
    },
    "fs": {}
  }
}
